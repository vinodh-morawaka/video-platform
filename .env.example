# Postgres. On Neon / Vercel Postgres, use the POOLED connection string
# (the one with "-pooler" in the hostname, or Vercel's POSTGRES_PRISMA_URL)
# for DATABASE_URL, and the UNPOOLED one (POSTGRES_URL_NON_POOLING) for
# DIRECT_URL — migrations need a direct connection. On plain Postgres
# (local, RDS, etc. with no pooler) both can be the same URL.
DATABASE_URL="postgresql://user:password@localhost:5432/videoplatform"
DIRECT_URL="postgresql://user:password@localhost:5432/videoplatform"

# Mux (managed video: ingest, transcode, storage, playback)
# https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
# https://dashboard.mux.com/settings/webhooks -> signing secret
MUX_WEBHOOK_SECRET=""

# Public app URL, used as the CORS origin for direct uploads
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js (NextAuth v5) — generate with: npx auth secret
# (or: openssl rand -base64 33)
AUTH_SECRET=""
